{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Motown AI",
  "version": "0.1.1",
  "identifier": "com.motownai.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "publisher": "Motown AI",
    "category": "Education",
    "shortDescription": "Study packs, saved on your computer",
    "longDescription": "Motown AI on your laptop: the full web app, with every study pack saved on your computer so you can keep studying offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "../bundle/static/": "static/"
    }
  }
}

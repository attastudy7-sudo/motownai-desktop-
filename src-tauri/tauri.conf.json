{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Motown AI",
  "version": "0.1.0",
  "identifier": "com.motownai.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "publisher": "Motown AI",
    "category": "Education",
    "shortDescription": "Study packs, saved on your computer",
    "longDescription": "Motown AI on your laptop: the full web app, with every study pack saved on your computer so you can keep studying offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "installer/nsis-header.bmp"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "bannerPath": "installer/msi-banner.bmp",
        "dialogImagePath": "installer/msi-dialog.bmp"
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "resources": {
      "../bundle/static/": "static/"
    },
    "homepage": "https://www.motownai.com",
    "copyright": "© 2026 Motown AI",
    "licenseFile": "installer/terms.txt",
    "macOS": {
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        }
      },
      "minimumSystemVersion": "10.15"
    }
  }
}
